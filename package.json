{
  "name": "financial-analytics-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Financial Analytics Dashboard with Dynamic Visualizations & Configurable CSV Export",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend start",
    "seed": "npm --prefix backend run seed",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
