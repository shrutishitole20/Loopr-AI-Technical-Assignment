                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions?search=user_001&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "search", "value": "user_001" },
                { "key": "limit", "value": "5" }
              ]
            },
            "description": "Real-time search across transaction fields."
          },
          "response": []
        },
        {
          "name": "Get Transaction By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
