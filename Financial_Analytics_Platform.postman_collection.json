            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions?category=Revenue&status=Paid&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "category", "value": "Revenue" },
                { "key": "status", "value": "Paid" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Filters transactions by category and status."
          },
          "response": []
        },
