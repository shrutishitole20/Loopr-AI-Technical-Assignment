            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions?startDate=2024-01-01&endDate=2024-12-31&minAmount=1000&maxAmount=3000",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "startDate", "value": "2024-01-01" },
                { "key": "endDate", "value": "2024-12-31" },
