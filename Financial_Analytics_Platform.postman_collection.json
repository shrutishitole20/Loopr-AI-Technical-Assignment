        {
          "name": "Export CSV (Configurable Columns)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columns\": [\"id\", \"date\", \"amount\", \"category\", \"status\", \"user_id\"],\n  \"filters\": {\n    \"category\": \"Revenue\",\n    \"status\": \"Paid\"\n  },\n  \"exportAll\": true,\n  \"fileName\": \"financial_audit_export\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/export",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "export"]
            },
            "description": "Generates RFC 4180 standard CSV download with customized columns."
          },
          "response": []
